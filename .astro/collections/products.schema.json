{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "whole-dried-herbs",
        "tea-blends",
        "fresh-herbs",
        "face-body",
        "tinctures-formulas",
        "tinctures-singles",
        "culinary",
        "csa"
      ]
    },
    "price": {
      "type": "number"
    },
    "priceDisplay": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "inStock": {
      "default": true,
      "type": "boolean"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "stripePriceId": {
            "type": "string"
          },
          "inStock": {
            "default": true,
            "type": "boolean"
          },
          "stripeNickname": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "price",
          "stripePriceId"
        ]
      }
    },
    "isSubscription": {
      "default": false,
      "type": "boolean"
    },
    "subscriptionInterval": {
      "type": "string",
      "enum": [
        "month",
        "quarter",
        "year"
      ]
    },
    "slidingScale": {
      "type": "object",
      "properties": {
        "low": {
          "type": "object",
          "properties": {
            "price": {
              "type": "number"
            },
            "stripePriceId": {
              "type": "string"
            },
            "stripeNickname": {
              "type": "string"
            }
          },
          "required": [
            "price",
            "stripePriceId"
          ]
        },
        "middle": {
          "type": "object",
          "properties": {
            "price": {
              "type": "number"
            },
            "stripePriceId": {
              "type": "string"
            },
            "stripeNickname": {
              "type": "string"
            }
          },
          "required": [
            "price",
            "stripePriceId"
          ]
        },
        "high": {
          "type": "object",
          "properties": {
            "price": {
              "type": "number"
            },
            "stripePriceId": {
              "type": "string"
            },
            "stripeNickname": {
              "type": "string"
            }
          },
          "required": [
            "price",
            "stripePriceId"
          ]
        }
      },
      "required": [
        "low",
        "middle",
        "high"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedProducts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "category",
    "price",
    "priceDisplay",
    "image",
    "sku"
  ]
}