---
import { productHref } from '@/lib/constants';

interface Props {
  slug: string;
  title: string;
  description: string;
  price: number;
  priceDisplay: string;
  /** Main image URL, or null when the product has no photo yet. */
  image: string | null;
  category: string;
  inStock: boolean;
  variants?: { label: string; price: number; stripePriceId: string; inStock: boolean }[];
  isSubscription?: boolean;
  slidingScale?: {
    low: { price: number; stripePriceId: string };
    middle: { price: number; stripePriceId: string };
    high: { price: number; stripePriceId: string };
  };
}

const {
  slug,
  title,
  description,
  priceDisplay,
  image,
  category,
  inStock,
  variants,
  isSubscription,
  slidingScale,
} = Astro.props;

const href = productHref(slug);

function formatPrice(cents: number) {
  return `$${(cents / 100).toFixed(2)}`;
}
---

<!-- The whole tile is one link: the title's link is stretched over the card
     with ::after, so assistive tech hears a single link named for the product. -->
<article
  class="group relative bg-white rounded-[--radius-card] border border-sage-200 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 hover:border-forest-500 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-forest-500 transition-[box-shadow,transform,border-color] flex flex-col"
  data-category={category}
>
  <!-- Product Image -->
  <div class="relative aspect-square bg-gradient-to-br from-sage-100 to-earth-100 overflow-hidden">
    {image ? (
      <img
        src={image}
        alt=""
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-sage-400">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <polyline points="21 15 16 10 5 21" />
        </svg>
      </div>
    )}
    {!inStock && (
      <span class="absolute top-3 left-3 px-4 py-1.5 bg-white/90 text-earth-500 text-lg font-medium rounded-full">
        Sold out
      </span>
    )}
  </div>

  <!-- Product Info -->
  <div class="p-4 flex flex-col flex-1">
    <h3 class="font-display font-semibold text-forest-900 group-hover:text-forest-700 transition-colors line-clamp-2 mb-1">
      <a href={href} class="outline-none after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <p class="text-sm text-earth-500 line-clamp-2 mb-3">{description}</p>

    <p class="mt-auto text-forest-700 font-semibold">
      {slidingScale ? (
        `from ${formatPrice(slidingScale.low.price)}`
      ) : (
        priceDisplay
      )}
      {isSubscription && (
        <span class="text-xs font-normal text-earth-500"> / quarter</span>
      )}
    </p>
  </div>
</article>
