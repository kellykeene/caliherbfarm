---
import { productHref } from '@/lib/constants';

interface Props {
  slug: string;
  title: string;
  description: string;
  price: number;
  priceDisplay: string;
  /** Main image URL, or null when the product has no photo yet. */
  image: string | null;
  category: string;
  inStock: boolean;
  variants?: { label: string; price: number; stripePriceId: string; inStock: boolean }[];
  isSubscription?: boolean;
  slidingScale?: {
    low: { price: number; stripePriceId: string };
    middle: { price: number; stripePriceId: string };
    high: { price: number; stripePriceId: string };
  };
}

const {
  slug,
  title,
  description,
  priceDisplay,
  image,
  category,
  inStock,
  variants,
  isSubscription,
  slidingScale,
} = Astro.props;

const href = productHref(slug);

function formatPrice(cents: number) {
  return `$${(cents / 100).toFixed(2)}`;
}
---

<article
  class="bg-white rounded-[--radius-card] border border-sage-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col"
  data-category={category}
>
  <!-- Product Image -->
  <div class="relative group">
    <a href={href} class="block aspect-square bg-gradient-to-br from-sage-100 to-earth-100 overflow-hidden">
      {image ? (
        <img
          src={image}
          alt=""
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-sage-400">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="40"
            height="40"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
        </div>
      )}
    </a>
    {inStock && (
      <button
        type="button"
        data-quick-view
        data-qv-image={image ?? ''}
        data-qv-title={title}
        data-qv-price={slidingScale ? `from ${formatPrice(slidingScale.low.price)}` : priceDisplay}
        data-qv-description={description}
        data-qv-href={href}
        class="absolute bottom-2 left-2 right-2 min-h-[40px] bg-white/90 backdrop-blur-sm text-forest-700 text-sm font-medium rounded-lg opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity hover:bg-white"
      >
        Quick View
      </button>
    )}
  </div>

  <!-- Product Info -->
  <div class="p-4 flex flex-col flex-1">
    <a href={href} class="hover:text-forest-700 transition-colors">
      <h3 class="font-display font-semibold text-forest-900 line-clamp-2 mb-1">
        {title}
      </h3>
    </a>
    <p class="text-sm text-earth-500 line-clamp-2 mb-3">{description}</p>

    <div class="mt-auto">
      <!-- Price -->
      <p class="text-forest-700 font-semibold mb-3">
        {slidingScale ? (
          `from ${formatPrice(slidingScale.low.price)}`
        ) : (
          priceDisplay
        )}
        {isSubscription && (
          <span class="text-xs font-normal text-earth-500"> / quarter</span>
        )}
      </p>

      <!-- Action -->
      {inStock ? (
        <a
          href={href}
          class="inline-flex items-center justify-center w-full min-h-[44px] px-4 py-2.5 bg-forest-700 text-white text-sm font-medium rounded-[--radius-card] hover:bg-forest-900 transition-colors"
        >
          {isSubscription ? 'View Options' : 'View Product'}
        </a>
      ) : (
        <span class="inline-flex items-center justify-center w-full min-h-[44px] px-4 py-2.5 bg-earth-100 text-earth-500 text-sm font-medium rounded-[--radius-card] cursor-not-allowed">
          Sold Out
        </span>
      )}
    </div>
  </div>
</article>
