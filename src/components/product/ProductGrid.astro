---
import ProductCard from './ProductCard.astro';
// Both call sites already pass merged catalog products, so use that type
// directly rather than restating the shape — mainImageUrl needs the media.
import { mainImageUrl, type CatalogProduct } from '@/lib/catalog';

interface Props {
  products: CatalogProduct[];
  /** Unique per page — several grids can appear on one page. */
  id?: string;
  label?: string;
}

const { products, id = 'product-grid', label = 'Products' } = Astro.props;
---

<div
  id={id}
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
  role="list"
  aria-label={label}
>
  {products.map((product) => (
    <div role="listitem" data-category={product.data.category}>
      <ProductCard
        slug={product.id}
        title={product.data.title}
        description={product.data.description}
        price={product.data.price}
        priceDisplay={product.data.priceDisplay}
        image={mainImageUrl(product)}
        category={product.data.category}
        inStock={product.data.inStock}
        variants={product.data.variants}
        isSubscription={product.data.isSubscription}
        slidingScale={product.data.slidingScale}
      />
    </div>
  ))}
</div>
