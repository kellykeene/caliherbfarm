---
// Separate newsletter form for seasonal herb availability notifications
---

<form
  name="herb-bulletin"
  method="POST"
  data-netlify="true"
  aria-label="Seasonal herb bulletin signup"
  class="max-w-md mx-auto"
>
  <input type="hidden" name="form-name" value="herb-bulletin" />
  <div class="flex flex-col sm:flex-row gap-3">
    <div class="flex-1">
      <label for="email-bulletin" class="sr-only">
        Email address
      </label>
      <input
        type="email"
        id="email-bulletin"
        name="email"
        required
        placeholder="Your email address"
        autocomplete="email"
        class="w-full px-4 py-3 rounded-[--radius-card] text-sm bg-white border-2 border-sage-200 text-forest-900 placeholder:text-earth-500 focus:border-forest-500 transition-colors"
      />
    </div>
    <button
      type="submit"
      class="min-h-[44px] px-6 py-3 bg-forest-700 text-white text-sm font-medium rounded-[--radius-card] hover:bg-forest-900 transition-colors"
    >
      Join Bulletin
    </button>
  </div>
  <p class="text-xs text-earth-500 mt-2">
    Emails go out the week before herbs are ready to harvest. Spring &amp; summer only.
  </p>
</form>
