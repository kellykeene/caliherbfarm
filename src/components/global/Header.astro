---
import { SITE } from '@/lib/constants';
import { buildNavLinks, getCategories } from '@/lib/catalog';

const NAV_LINKS = buildNavLinks(await getCategories());

/**
 * How the bar sits on this page, decided by BaseLayout:
 *   photo — floats over a background photo, so the controls go light
 *   wash  — floats over the wash, keeping its usual dark controls
 *   none  — the solid cream bar, for product, cart and text pages
 *
 * Either overlay reverts to the solid bar as soon as the page scrolls (see
 * the script below), so nothing ever slides under a see-through bar.
 */
interface Props {
  overlay?: 'photo' | 'wash' | 'none';
  /** Home only: the hero carries the big logo, so the bar's own stays out
   *  of the way until the hero scrolls off. */
  heroLogo?: boolean;
}

const { overlay = 'none', heroLogo = false } = Astro.props;
---

<header
  class="sticky top-0 z-40 bg-cream border-b border-sage-200"
  data-overlay={overlay}
  data-stuck={overlay === 'none' ? 'true' : 'false'}
  data-hero-logo={heroLogo ? 'visible' : 'hidden'}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- lg: logo and cart hug their content so the logo can grow; xl has room
         for equal side columns, which puts the nav at true center. -->
    <div class="flex items-center h-28 md:h-32 lg:grid lg:grid-cols-[auto_1fr_auto] lg:gap-6 xl:grid-cols-[1fr_auto_1fr] xl:gap-4">
      <!-- Logo -->
      <a
        id="header-logo"
        data-chrome
        href="/"
        class="flex min-w-0 flex-1 items-center md:flex-none lg:justify-self-start"
        aria-label="Cali Herb Farm — home"
      >
        <img
          src="/cali-herb-farm-logo.png"
          alt="Cali Herb Farm"
          width="2061"
          height="786"
          class="w-full h-auto max-h-24 object-contain object-left md:w-auto md:h-28 md:max-h-none lg:h-24 xl:h-28 max-w-none drop-shadow-sm"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Main navigation" class="hidden lg:block lg:col-start-2 lg:justify-self-center">
        <ul class="flex items-center gap-1" role="list">
          {NAV_LINKS.map((link) => (
            <li class="relative group">
              <a
                data-chrome
                href={link.href}
                class="inline-flex items-center gap-1 px-2.5 xl:px-3 py-2 text-base xl:text-lg font-medium text-forest-900 hover:text-forest-700 hover:bg-forest-900/5 rounded-[--radius-card] transition-colors"
              >
                {link.label}
                {'children' in link && link.children && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="transition-transform group-hover:rotate-180"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                )}
              </a>
              {'children' in link && link.children && (
                <ul
                  class="absolute left-0 top-full mt-1 w-48 bg-cream border border-sage-200 rounded-[--radius-card] shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-all"
                  role="list"
                >
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-4 py-2.5 text-sm text-forest-700 hover:text-forest-900 hover:bg-forest-50 first:rounded-t-[--radius-card] last:rounded-b-[--radius-card] transition-colors"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <!-- Right side: Cart + Mobile menu -->
      <div class="flex items-center gap-2 ml-auto lg:col-start-3 lg:ml-0 lg:justify-self-end">
        <!-- Cart icon -->
        <a
          href="/cart"
          data-chrome
          aria-label="Shopping cart"
          class="relative min-w-[44px] min-h-[44px] flex items-center justify-center text-forest-900 hover:text-forest-700 hover:bg-forest-900/5 rounded-[--radius-card] transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span
            id="cart-count"
            class="absolute -top-1 -right-1 bg-barn-500 text-white text-xs font-bold min-w-[20px] h-5 flex items-center justify-center rounded-full hidden"
            aria-live="polite"
          ></span>
        </a>

        <!-- Mobile menu button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          data-chrome
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="lg:hidden min-w-[44px] min-h-[44px] flex items-center justify-center text-forest-900 hover:text-forest-700 hover:bg-forest-900/5 rounded-[--radius-card] transition-colors"
        >
          <svg
            id="menu-icon-open"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg
            id="menu-icon-close"
            class="hidden"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-sage-200 bg-cream"
    aria-hidden="true"
  >
    <nav aria-label="Mobile navigation" class="px-4 py-4 space-y-1">
      {NAV_LINKS.map((link) => (
        <>
          <a
            href={link.href}
            class="block px-3 py-3 text-base font-medium text-forest-700 hover:text-forest-900 hover:bg-forest-50 rounded-[--radius-card] transition-colors"
          >
            {link.label}
          </a>
          {'children' in link && link.children && (
            <div class="pl-4 space-y-1">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-2.5 text-sm text-sage-600 hover:text-forest-900 hover:bg-forest-50 rounded-[--radius-card] transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    transition:
      background-color 250ms ease,
      border-color 250ms ease;
  }

  /* Floating over a band: no bar of its own, so the photo or wash runs to the
     top of the window. `stuck` flips back to the solid bar on the first
     scroll, before any of the band's text can pass beneath the controls. */
  header[data-overlay='photo'][data-stuck='false'],
  header[data-overlay='wash'][data-stuck='false'] {
    background-color: transparent;
    border-color: transparent;
  }

  /* Only over a photo do the controls change color — the wash is light, so
     its dark controls stay as they are. [data-chrome] marks the bar-level
     controls, leaving the dropdown and mobile panel (both cream) alone. */
  header[data-overlay='photo'][data-stuck='false'] [data-chrome] {
    color: var(--color-cream);
  }
  header[data-overlay='photo'][data-stuck='false'] [data-chrome]:hover {
    color: #fff;
    background-color: rgb(255 255 255 / 0.14);
  }

  /* An open mobile panel needs a bar behind it, whatever the page. */
  header[data-menu-open='true'] {
    background-color: var(--color-cream);
    border-color: var(--color-sage-200);
  }
  header[data-menu-open='true'] [data-chrome] {
    color: var(--color-forest-900);
  }

  /* Reserve the logo's space at all times so revealing it never reflows the
     bar. visibility (not display) keeps it out of the tab order and the
     accessibility tree while hidden, and still animates. */
  #header-logo {
    transition: opacity 300ms ease, visibility 300ms;
  }

  /* Home: the hero's own logo is on screen, so the bar's would be a second
     copy of it a few pixels above. Tracked separately from `stuck`, since the
     bar turns solid well before the hero logo has scrolled away. */
  header[data-hero-logo='visible'] #header-logo {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    header,
    #header-logo {
      transition: none;
    }
  }
</style>

<script>
  // ClientRouter swaps the DOM on navigation without re-running module
  // scripts, so element listeners must be re-bound per page. astro:page-load
  // fires on the initial load and after every client-side navigation.
  let closeCurrentMenu: () => void = () => {};
  let onScroll: (() => void) | null = null;
  let heroLogoObserver: IntersectionObserver | null = null;

  /**
   * The bar floats over the band only while the page is at the very top, and
   * turns solid on the first scroll — waiting for the band to leave would
   * slide its heading and copy under see-through controls.
   *
   * Pages with no band (product, cart, text pages) render the solid bar from
   * the start and bind nothing.
   */
  function setupHeaderOverlay() {
    const header = document.querySelector<HTMLElement>('header');
    if (!header) return;

    // Re-bound per navigation, so drop the previous page's handlers or they
    // keep writing to a header that is no longer on screen.
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = null;
    heroLogoObserver?.disconnect();
    heroLogoObserver = null;

    setupHeroLogo(header);

    const band = document.querySelector('[data-page-band]');
    if (!band || header.dataset.overlay === 'none') {
      header.dataset.stuck = 'true';
      return;
    }

    const update = () => {
      header.dataset.stuck = window.scrollY > 0 ? 'true' : 'false';
    };
    onScroll = update;
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  /**
   * Home only: the bar's logo appears once the hero's big logo has passed
   * beneath the bar, so there is never a second copy of it on screen.
   */
  function setupHeroLogo(header: HTMLElement) {
    const heroLogo = document.getElementById('hero-logo');
    if (!heroLogo) {
      header.dataset.heroLogo = 'hidden';
      return;
    }

    heroLogoObserver = new IntersectionObserver(
      ([entry]) => {
        header.dataset.heroLogo = entry.isIntersecting ? 'visible' : 'hidden';
      },
      { rootMargin: `-${header.offsetHeight}px 0px 0px 0px`, threshold: 0 },
    );
    heroLogoObserver.observe(heroLogo);
  }

  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    if (!toggle || !menu) return;

    function openMenu() {
      toggle!.closest('header')!.dataset.menuOpen = 'true';
      toggle!.setAttribute('aria-expanded', 'true');
      toggle!.setAttribute('aria-label', 'Close menu');
      menu!.classList.remove('hidden');
      menu!.setAttribute('aria-hidden', 'false');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');

      // Focus first link in menu
      const firstLink = menu!.querySelector('a');
      firstLink?.focus();
    }

    function closeMenu() {
      toggle!.closest('header')!.dataset.menuOpen = 'false';
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', 'Open menu');
      menu!.classList.add('hidden');
      menu!.setAttribute('aria-hidden', 'true');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle!.focus();
    }

    closeCurrentMenu = closeMenu;

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Focus trap within mobile menu
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = menu.querySelectorAll<HTMLElement>('a, button');
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        toggle.focus();
      }
    });
  }

  // Bound once: document survives view transitions, so re-binding here would
  // stack a duplicate handler on every navigation.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const toggle = document.getElementById('mobile-menu-toggle');
    if (toggle?.getAttribute('aria-expanded') === 'true') closeCurrentMenu();
  });

  document.addEventListener('astro:page-load', setupMobileMenu);
  document.addEventListener('astro:page-load', setupHeaderOverlay);
</script>
