---
import { NAV_LINKS, SITE } from '@/lib/constants';
---

<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur-sm overflow-visible">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="/" class="relative z-50 flex items-center gap-2 text-forest-700 hover:text-forest-900 transition-colors">
        <img
          src="/cali-herb-farm-logo.png"
          alt="Cali Herb Farm"
          class="h-36 sm:h-48 w-auto translate-y-[35px] sm:translate-y-[75px] drop-shadow-lg"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Main navigation" class="hidden md:block">
        <ul class="flex items-center gap-1" role="list">
          {NAV_LINKS.map((link) => (
            <li class="relative group">
              <a
                href={link.href}
                class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-forest-700 hover:text-forest-900 hover:bg-forest-50 rounded-[--radius-card] transition-colors"
              >
                {link.label}
                {'children' in link && link.children && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="transition-transform group-hover:rotate-180"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                )}
              </a>
              {'children' in link && link.children && (
                <ul
                  class="absolute left-0 top-full mt-1 w-48 bg-cream border border-sage-200 rounded-[--radius-card] shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-all"
                  role="list"
                >
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-4 py-2.5 text-sm text-forest-700 hover:text-forest-900 hover:bg-forest-50 first:rounded-t-[--radius-card] last:rounded-b-[--radius-card] transition-colors"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <!-- Right side: Cart + Mobile menu -->
      <div class="flex items-center gap-2">
        <!-- Cart icon -->
        <a
          href="/cart"
          aria-label="Shopping cart"
          class="relative min-w-[44px] min-h-[44px] flex items-center justify-center text-forest-700 hover:text-forest-900 hover:bg-forest-50 rounded-[--radius-card] transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span
            id="cart-count"
            class="absolute -top-1 -right-1 bg-plum-600 text-white text-xs font-bold min-w-[20px] h-5 flex items-center justify-center rounded-full hidden"
            aria-live="polite"
          ></span>
        </a>

        <!-- Mobile menu button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden min-w-[44px] min-h-[44px] flex items-center justify-center text-forest-700 hover:text-forest-900 hover:bg-forest-50 rounded-[--radius-card] transition-colors"
        >
          <svg
            id="menu-icon-open"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg
            id="menu-icon-close"
            class="hidden"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Logo-style border: red band with white inner lines -->
  <div aria-hidden="true" class="h-2 bg-barn-500 border-y border-white/60"></div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-sage-200 bg-cream"
    aria-hidden="true"
  >
    <nav aria-label="Mobile navigation" class="px-4 py-4 space-y-1">
      {NAV_LINKS.map((link) => (
        <>
          <a
            href={link.href}
            class="block px-3 py-3 text-base font-medium text-forest-700 hover:text-forest-900 hover:bg-forest-50 rounded-[--radius-card] transition-colors"
          >
            {link.label}
          </a>
          {'children' in link && link.children && (
            <div class="pl-4 space-y-1">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-2.5 text-sm text-sage-600 hover:text-forest-900 hover:bg-forest-50 rounded-[--radius-card] transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function openMenu() {
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close menu');
    menu?.classList.remove('hidden');
    menu?.setAttribute('aria-hidden', 'false');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');

    // Focus first link in menu
    const firstLink = menu?.querySelector('a');
    firstLink?.focus();
  }

  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
    menu?.classList.add('hidden');
    menu?.setAttribute('aria-hidden', 'true');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });

  // Focus trap within mobile menu
  menu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = menu.querySelectorAll<HTMLElement>('a, button');
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      toggle?.focus();
    }
  });
</script>
