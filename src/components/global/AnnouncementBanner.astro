---
/**
 * The message is fetched at runtime from /api/announcement rather than baked
 * in at build time, so editing it at /admin/announcement takes effect
 * immediately without a redeploy. The banner starts hidden and reveals itself
 * once a message arrives, which keeps it from flashing empty on load.
 */
---

<div
  id="announcement-banner"
  role="region"
  aria-label="Announcement"
  hidden
  class="bg-white text-forest-900 text-center text-sm px-4 py-3 relative"
>
  <p id="announcement-message" class="max-w-4xl mx-auto pr-8"></p>
  <button
    type="button"
    id="dismiss-banner"
    aria-label="Dismiss announcement"
    class="absolute right-3 top-1/2 -translate-y-1/2 min-w-[44px] min-h-[44px] flex items-center justify-center text-forest-900/60 hover:text-forest-900 transition-colors"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</div>

<script>
  const DISMISS_KEY = 'banner-dismissed-message';

  async function initAnnouncement() {
    const banner = document.getElementById('announcement-banner');
    const messageEl = document.getElementById('announcement-message');
    const dismiss = document.getElementById('dismiss-banner');
    if (!banner || !messageEl || !dismiss) return;

    let data: { message?: string; enabled?: boolean };
    try {
      const res = await fetch('/api/announcement', { cache: 'no-store' });
      if (!res.ok) return;
      data = await res.json();
    } catch {
      // Offline or the endpoint is unavailable — just leave the banner hidden.
      return;
    }

    const message = (data.message ?? '').trim();
    if (!data.enabled || !message) return;

    // Dismissal is keyed to the message itself, so a NEW announcement shows up
    // again for someone who dismissed the previous one.
    if (localStorage.getItem(DISMISS_KEY) === message) return;

    messageEl.textContent = message;
    banner.hidden = false;

    dismiss.addEventListener('click', () => {
      banner.hidden = true;
      localStorage.setItem(DISMISS_KEY, message);
    });
  }

  initAnnouncement();
  document.addEventListener('astro:after-swap', initAnnouncement);
</script>
