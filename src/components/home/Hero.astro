---
import { SITE } from '@/lib/constants';
---

<section
  aria-labelledby="hero-heading"
  class="relative bg-forest-700 text-white overflow-hidden"
>
  <!-- Farm photo background -->
  <img
    src="/anise-hyssop-basket.jpeg"
    alt="Anise hyssop harvested in a basket on the farm"
    class="absolute inset-0 w-full h-full object-cover"
    aria-hidden="true"
  />
  <!-- Dark overlay for text legibility -->
  <div
    class="absolute inset-0 bg-forest-900/40"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40 text-center">
    <h1
      id="hero-heading"
      class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight max-w-4xl mx-auto"
    >
      Hand-Harvested Medicinal Herbs, Grown Organically in Northern California
    </h1>
    <p class="mt-6 text-lg sm:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed">
      We cultivate 50+ varieties of medicinal herbs right here on our farm, using regenerative and organic methods with no shortcuts. Whole-plant herbs, live herb starts, dried bulk herbs, and tea blends hand-harvested daily and naturally air-dried in small batches for maximum freshness and quality.
    </p>
  </div>
</section>
