---
const categories = [
  {
    title: 'Herbal Remedies',
    description:
      'Handcrafted tinctures, teas, and topicals made from our farm-grown medicinal herbs. High efficacy formulas for everyday wellness.',
    href: '/shop',
    cta: 'Shop Remedies',
  },
  {
    title: 'Seasonal CSA',
    description:
      'Subscribe to our Community Supported Agriculture boxes. Receive a curated selection of seasonal remedies delivered quarterly.',
    href: '/shop?category=csa',
    cta: 'Learn More',
  },
  {
    title: 'Fresh Herbs',
    description:
      'Over 60 varieties of fresh medicinal herbs available seasonally. Grown with sustainable practices on our small farm.',
    href: '/fresh-herbs',
    cta: 'View Herbs',
  },
];
---

<section aria-labelledby="categories-heading" class="py-16 sm:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      id="categories-heading"
      class="font-display text-3xl sm:text-4xl font-bold text-forest-900 text-center mb-12"
    >
      What We Grow &amp; Make
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {categories.map((cat) => (
        <article class="bg-white rounded-[--radius-card] border border-sage-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          {/* Placeholder image area */}
          <div class="aspect-[4/3] bg-gradient-to-br from-sage-100 to-sage-200" />
          <div class="p-6">
            <h3 class="font-display text-xl font-bold text-forest-900 mb-2">
              {cat.title}
            </h3>
            <p class="text-earth-500 text-sm leading-relaxed mb-4">
              {cat.description}
            </p>
            <a
              href={cat.href}
              class="inline-flex items-center justify-center min-h-[44px] px-6 py-2.5 bg-barn-500 text-white text-sm font-medium rounded-[--radius-card] hover:bg-barn-700 transition-colors"
            >
              {cat.cta}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
