---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import { getStorefrontCatalog, mainImageUrl } from '@/lib/catalog';

// The cart snapshots an image URL into localStorage when an item is added, so
// hiding or replacing that image later would leave stale carts showing it.
// Resolve the current main image per slug instead; the snapshot is only a
// fallback for products no longer in the storefront.
const catalog = await getStorefrontCatalog();
const imageBySlug: Record<string, string | null> = Object.fromEntries(
  catalog.map((p) => [p.id, mainImageUrl(p)]),
);
---

<BaseLayout title="Cart" description="Your shopping cart at Cali Herb Farm.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ label: 'Cart', href: '/cart' }]} />
  </div>

  <section aria-labelledby="cart-heading" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h1
      id="cart-heading"
      class="font-display text-3xl sm:text-4xl font-bold text-forest-900 mb-8"
    >
      Your Cart
    </h1>

    <!-- Empty state -->
    <div id="cart-empty" class="text-center py-16 hidden">
      <p class="text-earth-500 text-lg mb-6">Your cart is empty.</p>
      <a
        href="/shop"
        class="inline-flex items-center justify-center min-h-[44px] px-8 py-3 bg-forest-700 text-white font-semibold rounded-[--radius-card] hover:bg-forest-900 transition-colors"
      >
        Browse Products
      </a>
    </div>

    <!-- Cart items -->
    <div id="cart-items" class="space-y-4">
      <!-- Populated by JS -->
    </div>

    <!-- Cart summary -->
    <div id="cart-summary" class="mt-8 pt-8 border-t-2 border-sage-200 hidden">
      <div class="flex items-center justify-between mb-6">
        <span class="text-lg font-semibold text-forest-900">Total</span>
        <span id="cart-total" class="text-2xl font-bold text-forest-700"></span>
      </div>
      <p id="subscription-note" class="text-sm text-earth-500 mb-4 hidden">
        Your cart includes subscription items that will be billed on a recurring basis.
      </p>
      <button
        type="button"
        id="checkout-btn"
        class="w-full min-h-[44px] px-8 py-4 bg-forest-700 text-white font-semibold text-lg rounded-[--radius-card] hover:bg-forest-900 transition-colors"
      >
        Proceed to Checkout
      </button>
      <p class="text-center text-sm text-earth-500 mt-3">
        You'll be redirected to Stripe's secure checkout.
      </p>
    </div>
  </section>

  <script type="application/json" id="cart-images" set:html={JSON.stringify(imageBySlug)} />
</BaseLayout>

<script>
  import {
    getCart,
    removeFromCart,
    updateQuantity,
    getCartTotal,
    type CartItem,
  } from '@/lib/cart';

  function formatPrice(cents: number) {
    return `$${(cents / 100).toFixed(2)}`;
  }

  const imageBySlug: Record<string, string | null> = JSON.parse(
    document.getElementById('cart-images')?.textContent || '{}',
  );

  /**
   * The live main image wins, so hiding or swapping it in the admin takes
   * effect in carts that were filled beforehand. Falls back to the stored
   * snapshot only for products that have left the storefront entirely.
   */
  function currentImage(item: CartItem): string | null {
    return item.slug in imageBySlug ? imageBySlug[item.slug] : item.image || null;
  }

  function renderCart() {
    const cart = getCart();
    const itemsEl = document.getElementById('cart-items')!;
    const emptyEl = document.getElementById('cart-empty')!;
    const summaryEl = document.getElementById('cart-summary')!;
    const totalEl = document.getElementById('cart-total')!;
    const subNote = document.getElementById('subscription-note')!;

    if (cart.length === 0) {
      emptyEl.classList.remove('hidden');
      itemsEl.classList.add('hidden');
      summaryEl.classList.add('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    itemsEl.classList.remove('hidden');
    summaryEl.classList.remove('hidden');

    const hasSubscription = cart.some((item) => item.isSubscription);
    if (hasSubscription) {
      subNote.classList.remove('hidden');
    }

    totalEl.textContent = formatPrice(getCartTotal());

    itemsEl.innerHTML = cart
      .map(
        (item) => `
      <div class="flex items-start gap-4 p-4 bg-white rounded-[--radius-card] border border-sage-200" data-slug="${item.slug}" data-variant="${item.variant}">
        <div class="w-20 h-20 rounded-lg bg-gradient-to-br from-sage-100 to-earth-100 flex-shrink-0 flex items-center justify-center text-sage-400 overflow-hidden">
          ${
            currentImage(item)
              ? `<img src="${currentImage(item)}" alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" />`
              : `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
          </svg>`
          }
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-forest-900">${item.title}</h3>
          <p class="text-sm text-earth-500">${item.variant}${item.isSubscription ? ' (Subscription)' : ''}</p>
          <p class="text-sm font-semibold text-forest-700 mt-1">${formatPrice(item.price)}</p>
        </div>
        <div class="flex items-center gap-2">
          ${
            item.isSubscription
              ? '<span class="text-sm text-earth-500 px-2">Qty: 1</span>'
              : `
            <div class="flex items-center border border-sage-200 rounded-lg">
              <button type="button" data-action="decrease" data-slug="${item.slug}" data-variant="${item.variant}" aria-label="Decrease quantity" class="min-w-[44px] min-h-[44px] flex items-center justify-center text-forest-700 hover:bg-forest-50">-</button>
              <span class="min-w-[32px] text-center text-sm font-semibold">${item.quantity}</span>
              <button type="button" data-action="increase" data-slug="${item.slug}" data-variant="${item.variant}" aria-label="Increase quantity" class="min-w-[44px] min-h-[44px] flex items-center justify-center text-forest-700 hover:bg-forest-50">+</button>
            </div>
          `
          }
          <button type="button" data-action="remove" data-slug="${item.slug}" data-variant="${item.variant}" aria-label="Remove ${item.title}" class="min-w-[44px] min-h-[44px] flex items-center justify-center text-earth-500 hover:text-red-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
        </div>
      </div>
    `,
      )
      .join('');

    // Bind item action buttons
    itemsEl.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const action = el.dataset.action;
        const slug = el.dataset.slug!;
        const variant = el.dataset.variant!;

        if (action === 'remove') {
          removeFromCart(slug, variant);
        } else if (action === 'decrease') {
          const item = getCart().find(
            (i) => i.slug === slug && i.variant === variant,
          );
          if (item) updateQuantity(slug, variant, item.quantity - 1);
        } else if (action === 'increase') {
          const item = getCart().find(
            (i) => i.slug === slug && i.variant === variant,
          );
          if (item) updateQuantity(slug, variant, item.quantity + 1);
        }

        renderCart();
        updateHeaderCount();
      });
    });
  }

  function updateHeaderCount() {
    const countEl = document.getElementById('cart-count');
    if (countEl) {
      const cart = getCart();
      const count = cart.reduce((sum, item) => sum + item.quantity, 0);
      if (count > 0) {
        countEl.textContent = String(count);
        countEl.classList.remove('hidden');
      } else {
        countEl.classList.add('hidden');
      }
    }
  }

  // Checkout button
  async function handleCheckout() {
    const cart = getCart();
    if (cart.length === 0) return;

    const btn = document.getElementById('checkout-btn') as HTMLButtonElement;
    btn.textContent = 'Redirecting...';
    btn.disabled = true;

    // Separate subscription and one-time items
    const subscriptionItems = cart.filter((i) => i.isSubscription);
    const oneTimeItems = cart.filter((i) => !i.isSubscription);

    try {
      // Handle one-time items
      if (oneTimeItems.length > 0) {
        const res = await fetch('/api/stripe/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: oneTimeItems.map((i) => ({
              stripePriceId: i.stripePriceId,
              quantity: i.quantity,
            })),
            isSubscription: false,
          }),
        });

        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
          return;
        }
      }

      // Handle subscription items
      if (subscriptionItems.length > 0) {
        const res = await fetch('/api/stripe/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: subscriptionItems.map((i) => ({
              stripePriceId: i.stripePriceId,
              quantity: 1,
            })),
            isSubscription: true,
          }),
        });

        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
          return;
        }
      }
    } catch (error) {
      console.error('Checkout error:', error);
      btn.textContent = 'Checkout failed — try again';
      btn.disabled = false;
    }
  }

  // renderCart/updateHeaderCount resolve their elements at call time, so they
  // only need re-invoking; the checkout button itself is replaced on
  // navigation and must be re-bound.
  document.addEventListener('astro:page-load', () => {
    document.getElementById('checkout-btn')?.addEventListener('click', handleCheckout);
    renderCart();
    updateHeaderCount();
  });
</script>
