---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/constants';
---

<BaseLayout title="Order Confirmed" description="Thank you for your order from Cali Herb Farm.">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
    <!-- Success icon -->
    <div class="mx-auto w-16 h-16 bg-forest-100 rounded-full flex items-center justify-center mb-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-forest-700"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </div>

    <h1 class="font-display text-3xl sm:text-4xl font-bold text-forest-900 mb-4">
      Thank You for Your Order!
    </h1>
    <p class="text-lg text-earth-500 mb-2">
      Your order has been confirmed and is being prepared.
    </p>
    <p class="text-earth-500 mb-8">
      You'll receive a confirmation email shortly with tracking details.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/shop"
        class="inline-flex items-center justify-center min-h-[44px] px-8 py-3 bg-forest-700 text-white font-semibold rounded-[--radius-card] hover:bg-forest-900 transition-colors"
      >
        Continue Shopping
      </a>
      <a
        href="/"
        class="inline-flex items-center justify-center min-h-[44px] px-8 py-3 border-2 border-forest-700 text-forest-700 font-semibold rounded-[--radius-card] hover:bg-forest-50 transition-colors"
      >
        Return Home
      </a>
    </div>

    <p class="text-sm text-earth-500 mt-12">
      Questions about your order? Contact us at{' '}
      <a
        href={`mailto:${SITE.email}`}
        class="text-forest-700 underline underline-offset-2 hover:text-forest-900"
      >
        {SITE.email}
      </a>
    </p>
  </section>
</BaseLayout>

<script>
  import { clearCart } from '@/lib/cart';

  // Clear the cart after successful order
  clearCart();

  // Update header cart count
  const countEl = document.getElementById('cart-count');
  if (countEl) {
    countEl.classList.add('hidden');
  }
</script>
