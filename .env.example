# Stripe — keys start sk_test_ / pk_test_ (sk_live_ / pk_live_ at launch); the
# webhook signing secret starts whsec_. Left blank on purpose: a placeholder
# copied into Netlify matches this file and fails the build's secrets scan.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Site
SITE_URL=https://caliherbfarm.com

# Instagram (optional)
INSTAGRAM_TOKEN=

# Newsletter service (optional)
NEWSLETTER_API_KEY=

# Admin section — generate both with: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Pre-launch: set to "true" to send X-Robots-Tag: noindex on every response,
# keeping the temporary *.netlify.app URL out of Google. Netlify only adds this
# automatically to deploy previews, NOT to the production deploy.
# DELETE THIS AT LAUNCH — left on, the site never appears in search results.
SITE_NOINDEX=
